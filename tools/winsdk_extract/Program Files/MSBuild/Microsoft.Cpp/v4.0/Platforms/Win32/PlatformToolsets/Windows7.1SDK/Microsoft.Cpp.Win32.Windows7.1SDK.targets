***********************************************************************************************
-->

<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Target Name="_WindowsSDKPrepareForBuild" BeforeTargets="_PrepareForBuild">
    <!-- Error out if the user tried to use the Windows 7 SDK toolset but doesn't have Windows 7 SDK installed -->
    <Error Text="Windows 7.1 SDK not found. Please make sure that the Windows 7.1 SDK is installed on the machine." Condition="'$(Registry:HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Microsoft SDKs\Windows\v7.1@InstallationFolder)'==''" />
    <Error Text="You are attempting to build a Win32 application from an x64 environment. If using the Windows 7.1 SDK build environment, type setenv /x86" Condition="'$(WindowsSDKVersionOverride)' != '' and '$(TARGET_CPU)' == 'x64'"/>
    <Error Text="You are attempting to build a Win32 application from an Itanium (IA64) environment. If using the Windows 7.1 SDK build environment, type setenv /x86" Condition="'$(WindowsSDKVersionOverride)' != '' and '$(TARGET_CPU)' == 'IA64'"/>
  </Target>  
</Project>
